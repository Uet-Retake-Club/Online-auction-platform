# Ignore IDE and OS files
.idea/
.vscode/
*.iml
.DS_Store

# Ignore Gradle and Maven
.gradle/
build/
target/
bin/
out/
pom.xml.versionsBackup

# Ignore compiled Java
*.class

# Ignore Kotlin plugin data
.kotlin/

# Ignore Python artifacts
__pycache__/
*.py[cod]
*$py.class

# Ignore Node.js
node_modules/

# Ignore local databases (but keep schema.sql)
database/*.db
database/*.sqlite
*.sqlite3

# Ignore Logs
*.log