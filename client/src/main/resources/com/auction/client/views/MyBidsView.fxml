<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    MyBidsView.fxml
    Controller : com.auction.client.controllers.MyBidsController
    Màn hình lịch sử đặt giá của Bidder — hiển thị tất cả các phiên
    đấu giá đã tham gia với trạng thái: Winning / Outbid / Won / Lost.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controllers.MyBidsController"
            fx:id="rootPane"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ══ TOP NAV ══════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-nav">
            <HBox alignment="CENTER_LEFT" spacing="0" onMouseClicked="#onHome" style="-fx-cursor: hand;">
                <Label text="Auction" styleClass="heading-3" style="-fx-text-fill: -primary; -fx-font-size: 22px;"/>
                <Label text="Hub"     styleClass="heading-3" style="-fx-text-fill: -text-main; -fx-font-size: 22px;"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="10">
                <Button text="Browse" onAction="#onHome" styleClass="btn-ghost"/>
                <Button text="+ Sell" onAction="#onSell" styleClass="button, btn-primary" style="-fx-padding: 8px 20px;"/>
                
                <Separator orientation="VERTICAL" style="-fx-padding: 0 10px;"/>
                
                <Button text="☀/🌙" onAction="#onToggleTheme" styleClass="btn-ghost" style="-fx-font-size: 16px;"/>
                
                <HBox alignment="CENTER" spacing="8" styleClass="badge" style="-fx-background-color: -primary-light; -fx-padding: 8px 16px; -fx-min-width: 140px; -fx-max-width: 220px;">
                    <Label text="💳" style="-fx-font-size: 14px;"/>
                    <Label fx:id="navWalletBalanceLabel" text="Loading..." styleClass="label-bold" style="-fx-text-fill: -primary;"/>
                </HBox>

                <Label fx:id="userLabel" text="JD" onMouseClicked="#onProfile"
                       styleClass="badge"
                       style="-fx-background-color: -primary-light; -fx-text-fill: -primary; -fx-padding: 8px 14px; -fx-background-radius: 20px; -fx-cursor: hand;"/>
            </HBox>
        </HBox>
    </top>

    <!-- ══ LEFT SIDEBAR ════════════════════════════════════ -->
    <left>
        <VBox prefWidth="220" spacing="4" styleClass="sidebar">
            <Label text="MY BIDS" styleClass="body-small" style="-fx-font-weight: bold; -fx-padding: 0 12px 10px 12px;"/>
            
            <Button fx:id="filterAll"      text="All bids"   maxWidth="Infinity" onAction="#onFilterAll"      styleClass="nav-item-active"/>
            <Button fx:id="filterWinning"  text="Winning"    maxWidth="Infinity" onAction="#onFilterWinning"  styleClass="nav-item"/>
            <Button fx:id="filterOutbid"   text="Outbid"     maxWidth="Infinity" onAction="#onFilterOutbid"   styleClass="nav-item"/>
            <Button fx:id="filterWon"      text="Won"        maxWidth="Infinity" onAction="#onFilterWon"      styleClass="nav-item"/>
            <Button fx:id="filterWatchlist" text="Watchlist" maxWidth="Infinity" onAction="#onFilterWatchlist" styleClass="nav-item"/>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <Separator style="-fx-opacity: 0.3; -fx-padding: 10px 0;"/>
            
            <Button text="Home"     maxWidth="Infinity" onAction="#onHome"   styleClass="nav-item"/>
            <Button text="Sign out" maxWidth="Infinity" onAction="#onLogout" styleClass="nav-item"/>
        </VBox>
    </left>

    <!-- ══ MAIN CONTENT ═════════════════════════════════════ -->
    <center>
        <VBox style="-fx-padding: 30px;" spacing="24" VBox.vgrow="ALWAYS">

            <!-- Header row -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="My bids" styleClass="heading-1" HBox.hgrow="ALWAYS"/>
                <Label fx:id="bidCountLabel" text="5 bids total" styleClass="body-text" style="-fx-text-fill: -text-muted;"/>
            </HBox>

            <!-- Bids table card -->
            <VBox styleClass="card" style="-fx-padding: 0;" VBox.vgrow="ALWAYS">

                <!-- Table header -->
                <HBox styleClass="card-img-placeholder" style="-fx-background-radius: 8px 8px 0 0; -fx-padding: 12px 20px; -fx-border-width: 0 0 1px 0;">
                    <Label text="Item" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                    <Label text="My bid" prefWidth="120" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                    <Label text="Current price" prefWidth="140" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                    <Label text="Time left" prefWidth="120" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                    <Label text="Status" prefWidth="100" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                    <Label text="" prefWidth="100" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                </HBox>

                <!-- Rows — populated by MyBidsController -->
                <VBox fx:id="bidsListContainer" VBox.vgrow="ALWAYS"/>

                <!-- Empty state -->
                <VBox fx:id="emptyState" alignment="CENTER" spacing="15"
                      style="-fx-padding: 80px 0;" visible="false" managed="false">
                    <Label text="No bids found" styleClass="heading-2" style="-fx-text-fill: -text-muted;"/>
                    <Label text="You haven't placed any bids yet." styleClass="body-text" style="-fx-text-fill: -text-muted;"/>
                    <Button text="Browse auctions" onAction="#onHome" styleClass="button, btn-primary" style="-fx-padding: 10px 24px;"/>
                </VBox>

            </VBox>
        </VBox>
    </center>

</BorderPane>
