<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    CreateListingView.fxml
    Controller : com.auction.client.controllers.CreateListingController
    Màn hình Seller đăng sản phẩm đấu giá mới.
    Gồm: tiêu đề, danh mục, mô tả, giá khởi điểm, bước giá, thời gian.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controllers.CreateListingController"
            fx:id="rootPane"
            maxWidth="Infinity" maxHeight="Infinity"
            style="-fx-background-color: #F4F4F4;">

    <!-- ══ TOP NAV ══════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color:white;-fx-border-color:transparent transparent #EBEBEB transparent;-fx-border-width:0 0 1px 0;-fx-padding:10px 20px;">
            <HBox alignment="CENTER_LEFT" spacing="0" onMouseClicked="#onHome" style="-fx-cursor: hand;">
                <Label text="Auction" style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:#E53238;-fx-font-family:'Segoe UI';"/>
                <Label text="Hub"     style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:#111111;-fx-font-family:'Segoe UI';"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="My listings" onAction="#onMyListings"
                    style="-fx-background-color:transparent;-fx-border-color:transparent;-fx-text-fill:#555;-fx-font-size:13px;-fx-cursor:hand;-fx-effect:null;-fx-padding:7px 12px;"/>
                        <Button text="☀/🌙" onAction="#onToggleTheme"
                    style="-fx-background-color:transparent;-fx-border-color:transparent;-fx-text-fill:#555;-fx-font-size:16px;-fx-cursor:hand;-fx-effect:null;-fx-padding:0 8px;"/>
            <Label fx:id="userLabel" text="JD" onMouseClicked="#onProfile"
                   style="-fx-background-color:#FDECEA;-fx-text-fill:#E53238;-fx-font-weight:bold;-fx-font-size:12px;-fx-padding:7px 13px;-fx-background-radius:20px;-fx-cursor:hand;"/>
        </HBox>
    </top>

    <!-- ══ LEFT SIDEBAR ════════════════════════════════════ -->
    <left>
        <VBox prefWidth="190" spacing="3"
              style="-fx-background-color:white;-fx-border-color:transparent #EBEBEB transparent transparent;-fx-border-width:0 1px 0 0;-fx-padding:18px 10px;">
            <Label text="SELLER MENU"
                   style="-fx-font-size:10px;-fx-font-weight:bold;-fx-text-fill:#AAAAAA;-fx-padding:0 8px 8px 8px;"/>
            <Button text="My listings"    maxWidth="Infinity" onAction="#onMyListings"
                    styleClass="nav-item" style="-fx-effect:null;"/>
            <Button text="Active auctions" maxWidth="Infinity" onAction="#onActiveAuctions"
                    styleClass="nav-item" style="-fx-effect:null;"/>
            <Button text="Drafts"          maxWidth="Infinity" onAction="#onDrafts"
                    styleClass="nav-item" style="-fx-effect:null;"/>
            <Button text="Completed"       maxWidth="Infinity" onAction="#onCompleted"
                    styleClass="nav-item" style="-fx-effect:null;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-opacity:0.5;"/>
            <Button text="Home"     maxWidth="Infinity" onAction="#onHome"
                    styleClass="nav-item" style="-fx-effect:null;"/>
            <Button text="Sign out" maxWidth="Infinity" onAction="#onLogout"
                    styleClass="nav-item" style="-fx-effect:null;"/>
        </VBox>
    </left>

    <!-- ══ MAIN FORM ════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="0" style="-fx-padding:24px;">

                <Label text="Create new listing"
                       style="-fx-font-size:18px;-fx-font-weight:bold;-fx-text-fill:#111;-fx-font-family:'Segoe UI';-fx-padding:0 0 16px 0;"/>

                <!-- Form card -->
                <VBox maxWidth="640" spacing="0"
                      style="-fx-background-color:white;-fx-border-color:#EBEBEB;-fx-border-width:1px;-fx-border-radius:8px;-fx-background-radius:8px;-fx-padding:24px;">

                    <!-- Title + Category row -->
                    <HBox spacing="14" style="-fx-padding:0 0 14px 0;">
                        <VBox HBox.hgrow="ALWAYS" spacing="0">
                            <Label text="Item title"
                                   style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#333;-fx-padding:0 0 5px 0;"/>
                            <TextField fx:id="titleField"
                                       promptText="e.g. Vintage Rolex Watch"
                                       styleClass="text-field-base" maxWidth="Infinity"/>
                            <Label fx:id="titleError" text="" styleClass="field-error"
                                   style="-fx-min-height:16px;-fx-padding:3px 0 0 0;"/>
                        </VBox>
                        <VBox prefWidth="180" spacing="0">
                            <Label text="Category"
                                   style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#333;-fx-padding:0 0 5px 0;"/>
                            <ComboBox fx:id="categoryCombo"
                                      promptText="Select category"
                                      maxWidth="Infinity"
                                      style="-fx-font-size:13px;"/>
                            <Label fx:id="categoryError" text="" styleClass="field-error"
                                   style="-fx-min-height:16px;-fx-padding:3px 0 0 0;"/>
                        </VBox>
                    </HBox>

                    <!-- Description -->
                    <VBox spacing="0" style="-fx-padding:0 0 14px 0;">
                        <Label text="Description"
                               style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#333;-fx-padding:0 0 5px 0;"/>
                        <TextArea fx:id="descriptionField"
                                  promptText="Describe your item in detail — condition, history, dimensions..."
                                  prefRowCount="4"
                                  maxWidth="Infinity"
                                  style="-fx-font-size:13px;-fx-border-color:#E0E0E0;-fx-border-width:1.5px;-fx-border-radius:6px;-fx-background-radius:6px;-fx-font-family:'Segoe UI';"/>
                        <Label fx:id="descriptionError" text="" styleClass="field-error"
                               style="-fx-min-height:16px;-fx-padding:3px 0 0 0;"/>
                    </VBox>

                    <!-- Starting price + Increment row -->
                    <HBox spacing="14" style="-fx-padding:0 0 14px 0;">
                        <VBox HBox.hgrow="ALWAYS" spacing="0">
                            <Label text="Starting price ($)"
                                   style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#333;-fx-padding:0 0 5px 0;"/>
                            <TextField fx:id="startPriceField"
                                       promptText="0.00"
                                       styleClass="text-field-base" maxWidth="Infinity"/>
                            <Label fx:id="startPriceError" text="" styleClass="field-error"
                                   style="-fx-min-height:16px;-fx-padding:3px 0 0 0;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="0">
                            <Label text="Minimum increment ($)"
                                   style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#333;-fx-padding:0 0 5px 0;"/>
                            <TextField fx:id="incrementField"
                                       promptText="1.00"
                                       styleClass="text-field-base" maxWidth="Infinity"/>
                            <Label fx:id="incrementError" text="" styleClass="field-error"
                                   style="-fx-min-height:16px;-fx-padding:3px 0 0 0;"/>
                        </VBox>
                    </HBox>

                    <!-- Start time + End time row -->
                    <HBox spacing="14" style="-fx-padding:0 0 14px 0;">
                        <VBox HBox.hgrow="ALWAYS" spacing="0">
                            <Label text="Start date &amp; time"
                                   style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#333;-fx-padding:0 0 5px 0;"/>
                            <TextField fx:id="startTimeField"
                                       promptText="YYYY-MM-DD HH:mm"
                                       styleClass="text-field-base" maxWidth="Infinity"/>
                            <Label fx:id="startTimeError" text="" styleClass="field-error"
                                   style="-fx-min-height:16px;-fx-padding:3px 0 0 0;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="0">
                            <Label text="End date &amp; time"
                                   style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#333;-fx-padding:0 0 5px 0;"/>
                            <TextField fx:id="endTimeField"
                                       promptText="YYYY-MM-DD HH:mm"
                                       styleClass="text-field-base" maxWidth="Infinity"/>
                            <Label fx:id="endTimeError" text="" styleClass="field-error"
                                   style="-fx-min-height:16px;-fx-padding:3px 0 0 0;"/>
                        </VBox>
                    </HBox>

                    <!-- Image upload placeholder -->
                    <VBox spacing="0" style="-fx-padding:0 0 20px 0;">
                        <Label text="Item image"
                               style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#333;-fx-padding:0 0 5px 0;"/>
                        <VBox fx:id="imageDropZone"
                              alignment="CENTER" prefHeight="80"
                              onMouseClicked="#onSelectImage"
                              style="-fx-border-color:#E0E0E0;-fx-border-width:1.5px;-fx-border-style:dashed;-fx-border-radius:6px;-fx-background-radius:6px;-fx-cursor:hand;">
                            <Label fx:id="imageLabel" text="Click to upload image"
                                   style="-fx-text-fill:#AAAAAA;-fx-font-size:13px;-fx-font-family:'Segoe UI';"/>
                        </VBox>
                    </VBox>

                    <!-- General error -->
                    <Label fx:id="generalError" text=""
                           style="-fx-text-fill:#E53238;-fx-font-size:12px;-fx-min-height:16px;-fx-padding:0 0 10px 0;"/>

                    <!-- Action buttons -->
                    <HBox spacing="12">
                        <Button fx:id="publishBtn" text="Publish listing"
                                onAction="#onPublish"
                                style="-fx-background-color:#E53238;-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:14px;-fx-border-color:transparent;-fx-border-radius:6px;-fx-background-radius:6px;-fx-padding:10px 24px;-fx-cursor:hand;-fx-effect:null;"/>
                        <Button fx:id="draftBtn" text="Save draft"
                                onAction="#onSaveDraft"
                                style="-fx-background-color:white;-fx-text-fill:#333;-fx-border-color:#E0E0E0;-fx-border-width:1.5px;-fx-border-radius:6px;-fx-background-radius:6px;-fx-padding:10px 24px;-fx-font-size:13px;-fx-cursor:hand;-fx-effect:null;"/>
                        <Button text="Cancel"
                                onAction="#onCancel"
                                style="-fx-background-color:transparent;-fx-text-fill:#888;-fx-border-color:transparent;-fx-font-size:13px;-fx-cursor:hand;-fx-effect:null;-fx-padding:10px 12px;"/>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
