<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<!--
    LoginView.fxml
    Controller : com.auction.client.controllers.LoginController
    CSS        : main.css loaded in ClientApplication.java
    Size       : 900 x 560

    THAY ĐỔI:
    - EmailField: onAction="#onFocusPassword" → nhấn Enter chuyển focus xuống password
    - PasswordField: onAction="#onLogin"      → nhấn Enter = nhấn Sign in
-->
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.controllers.LoginController"
      fx:id="rootPane"
      maxWidth="Infinity" maxHeight="Infinity">

    <!-- ════════════════════════════════════════════════════
         LEFT PANEL  — dark brand panel
         ════════════════════════════════════════════════════ -->
    <VBox minWidth="340" maxWidth="420"
          alignment="CENTER_LEFT"
          spacing="0"
          styleClass="auth-left-panel"
          style="-fx-padding: 52px 44px;">

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="0" onMouseClicked="#onHome" style="-fx-cursor: hand;">
            <Label text="Auction" styleClass="heading-1" style="-fx-text-fill: -primary; -fx-font-size: 32px;"/>
            <Label text="Hub"     styleClass="heading-1" style="-fx-text-fill: white; -fx-font-size: 32px;"/>
        </HBox>

        <!-- Tagline -->
        <Label text="Bid. Win. Repeat."
               styleClass="body-text"
               style="-fx-text-fill: rgba(255,255,255,0.5); -fx-padding: 8px 0 36px 0;"/>

        <!-- Feature bullets -->
        <VBox spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Circle radius="4" fill="#E53238"/>
                <Label text="Thousands of live auctions" styleClass="body-small" style="-fx-text-fill: rgba(255,255,255,0.75);"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Circle radius="4" fill="#E53238"/>
                <Label text="Real-time bidding engine" styleClass="body-small" style="-fx-text-fill: rgba(255,255,255,0.75);"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Circle radius="4" fill="#E53238"/>
                <Label text="Secure buyer protection" styleClass="body-small" style="-fx-text-fill: rgba(255,255,255,0.75);"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Circle radius="4" fill="#E53238"/>
                <Label text="Sell your items in minutes" styleClass="body-small" style="-fx-text-fill: rgba(255,255,255,0.75);"/>
            </HBox>
        </VBox>

    </VBox>

    <!-- ════════════════════════════════════════════════════
         RIGHT PANEL — login form
         ════════════════════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS"
          maxWidth="Infinity"
          alignment="CENTER"
          style="-fx-padding: 40px;">

        <!-- White card -->
        <VBox maxWidth="360"
              spacing="0"
              styleClass="card"
              style="-fx-padding: 36px;">

            <!-- Card heading -->
            <Label text="Welcome back" styleClass="heading-2"/>
            <Label text="Sign in to your account" styleClass="body-small" style="-fx-padding: 4px 0 28px 0;"/>

            <!-- Email -->
            <Label text="Email address" styleClass="label-bold" style="-fx-padding: 0 0 6px 0;"/>
            <TextField fx:id="emailField"
                       promptText="you@example.com"
                       styleClass="text-field-base"
                       maxWidth="Infinity"
                       onAction="#onFocusPassword"/>
            <Label fx:id="emailError" text="" styleClass="field-error" style="-fx-min-height: 16px; -fx-padding: 3px 0 10px 0;"/>

            <!-- Password -->
            <Label text="Password" styleClass="label-bold" style="-fx-padding: 0 0 6px 0;"/>
            <PasswordField fx:id="passwordField"
                           promptText="Your password"
                           styleClass="text-field-base"
                           maxWidth="Infinity"
                           onAction="#onLogin"/>
            <Label fx:id="passwordError" text="" styleClass="field-error" style="-fx-min-height: 16px; -fx-padding: 3px 0 4px 0;"/>

            <!-- Forgot password -->
            <HBox alignment="CENTER_RIGHT" style="-fx-padding: 0 0 20px 0;">
                <Label fx:id="forgotPasswordLabel"
                       text="Forgot password?"
                       styleClass="body-small"
                       style="-fx-text-fill: -info; -fx-cursor: hand;"
                       onMouseClicked="#onForgotPassword"/>
            </HBox>

            <!-- General auth error -->
            <Label fx:id="generalError" text="" styleClass="field-error" style="-fx-min-height: 16px; -fx-padding: 0 0 10px 0;"/>

            <!-- Sign in button -->
            <Button fx:id="loginButton"
                    text="Sign in"
                    styleClass="button, btn-primary"
                    maxWidth="Infinity"
                    onAction="#onLogin"
                    style="-fx-pref-height: 42px;"/>

            <!-- Divider row -->
            <HBox alignment="CENTER" spacing="10" style="-fx-padding: 20px 0;">
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="or" styleClass="body-small"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Sign up link -->
            <HBox alignment="CENTER" spacing="4">
                <Label text="Don't have an account?" styleClass="body-small"/>
                <Label fx:id="signUpLabel"
                       text="Create one"
                       styleClass="body-small"
                       style="-fx-text-fill: -info; -fx-cursor: hand;"
                       onMouseClicked="#onGoToSignUp"/>
            </HBox>

        </VBox>
    </VBox>

</HBox>
