<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controllers.AuctionDetailController"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ══ TOP NAV ══════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-nav">
            <HBox alignment="CENTER_LEFT" spacing="0" onMouseClicked="#onHome" style="-fx-cursor: hand;">
                <Label text="Auction" styleClass="heading-3" style="-fx-text-fill: -primary; -fx-font-size: 22px;"/>
                <Label text="Hub" styleClass="heading-3" style="-fx-text-fill: -text-main; -fx-font-size: 22px;"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="12">
                <Button text="Watchlist" onAction="#onWatchlist" styleClass="btn-ghost"/>
                <Button text="My bids" onAction="#onMyBids" styleClass="btn-ghost"/>
                <Button text="+ Sell" onAction="#onSell" styleClass="btn-primary"/>
                <Separator orientation="VERTICAL" style="-fx-pref-height: 20px;"/>
                <Button text="☀/🌙" onAction="#onToggleTheme" styleClass="btn-ghost" style="-fx-font-size: 16px;"/>
                
                <!-- Wallet Pill with fixed width to prevent stretching -->
                <HBox alignment="CENTER" spacing="8" styleClass="badge" style="-fx-background-color: -primary-light; -fx-padding: 8px 16px; -fx-min-width: 140px; -fx-max-width: 220px;">
                    <Label text="💳" style="-fx-font-size: 14px;"/>
                    <Label fx:id="walletBalanceLabel" text="Loading..." styleClass="label-bold" style="-fx-text-fill: -primary;"/>
                </HBox>
                
                <Label fx:id="userLabel" text="AD" onMouseClicked="#onProfile" styleClass="badge" style="-fx-background-color: -primary-light; -fx-text-fill: -primary; -fx-padding: 8px 14px; -fx-background-radius: 20px; -fx-cursor: hand;"/>
            </HBox>
        </HBox>
    </top>

    <!-- ══ MAIN CONTENT ═════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="20" style="-fx-padding: 24px 40px;">
                
                <!-- Compact Header / Breadcrumbs -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="backLabel" text="← Back" onMouseClicked="#onBack" styleClass="body-small" style="-fx-text-fill: -info; -fx-cursor: hand; -fx-font-weight: bold;"/>
                    <Separator orientation="VERTICAL" style="-fx-pref-height: 12px;"/>
                    <Label fx:id="itemMeta" text="Category · Seller" styleClass="body-small"/>
                </HBox>

                <!-- ── 2-Column Full-Width Layout ──────── -->
                <HBox spacing="24" alignment="TOP_LEFT">
                    
                    <!-- LEFT COLUMN: Image & Description & History (Fill) -->
                    <VBox HBox.hgrow="ALWAYS" spacing="16">
                        <!-- Image and Description integrated -->
                        <VBox styleClass="card" spacing="0">
                            <VBox alignment="CENTER" minHeight="360" maxHeight="480" styleClass="card-img-placeholder" 
                                  style="-fx-background-radius: 12px 12px 0 0; -fx-background-color: linear-gradient(to bottom right, -bg-surface-alt, -bg-surface); -fx-border-color: transparent transparent -border-color transparent; -fx-border-width: 0 0 1px 0;">
                                <VBox alignment="CENTER" spacing="10">
                                    <Label text="📷" style="-fx-font-size: 40px; -fx-opacity: 0.3;"/>
                                    <Label text="No product image available" styleClass="body-small" style="-fx-text-fill: -text-muted; -fx-font-weight: bold;"/>
                                </VBox>
                            </VBox>
                            <VBox style="-fx-padding: 16px;" spacing="8">
                                <Label text="Description" styleClass="label-bold" style="-fx-font-size: 14px;"/>
                                <Label fx:id="itemDescription" text="No description provided." styleClass="body-text" style="-fx-line-spacing: 2px; -fx-font-size: 13px;" wrapText="true"/>
                            </VBox>
                        </VBox>

                        <!-- 2. Bid History (Left Column) -->
                        <VBox spacing="12" styleClass="card" style="-fx-padding: 20px;" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Bid History" styleClass="label-bold" style="-fx-font-size: 15px;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="noBidsLabel" text="No bids yet" styleClass="body-small" style="-fx-text-fill: -text-muted;"/>
                            </HBox>
                            <ScrollPane fitToWidth="true" styleClass="scroll-pane" minHeight="200" maxHeight="600">
                                <VBox fx:id="bidHistoryList" spacing="8"/>
                            </ScrollPane>
                        </VBox>
                    </VBox>

                    <!-- RIGHT COLUMN: Actions (380px) -->
                    <VBox spacing="16" prefWidth="380" minWidth="380" maxWidth="420">
                        
                        <!-- 1. Interaction Card -->
                        <VBox spacing="14" styleClass="card" style="-fx-padding: 24px;">
                            <Label fx:id="itemTitle" text="Item Title" styleClass="heading-2" style="-fx-font-size: 20px;"/>
                            
                            <Separator style="-fx-opacity: 0.2;"/>

                            <!-- Price & Timer Row -->
                            <HBox spacing="10">
                                <VBox HBox.hgrow="ALWAYS" spacing="2">
                                    <Label text="Current Bid" styleClass="body-small" style="-fx-font-size: 10px;"/>
                                    <Label fx:id="currentPrice" text="0.00" styleClass="heading-1" style="-fx-text-fill: -primary; -fx-font-size: 24px;"/>
                                </VBox>
                                <VBox spacing="2" alignment="TOP_RIGHT">
                                    <Label text="Ends In" styleClass="body-small" style="-fx-font-size: 10px;"/>
                                    <Label fx:id="countdownTimer" text="00:00:00" styleClass="heading-2" style="-fx-text-fill: -warning; -fx-font-size: 20px;"/>
                                </VBox>
                            </HBox>

                            <!-- Stats Row -->
                            <HBox spacing="8">
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="card-img-placeholder" style="-fx-padding: 10px 4px; -fx-background-color: -bg-surface-alt;">
                                    <Label fx:id="totalBids" text="0" styleClass="label-bold" style="-fx-font-size: 13px;"/>
                                    <Label text="Bids" style="-fx-font-size: 10px;"/>
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="card-img-placeholder" style="-fx-padding: 10px 4px; -fx-background-color: -bg-surface-alt;">
                                    <Label fx:id="totalBidders" text="0" styleClass="label-bold" style="-fx-font-size: 13px;"/>
                                    <Label text="Bidders" style="-fx-font-size: 10px;"/>
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="card-img-placeholder" style="-fx-padding: 10px 4px; -fx-background-color: -bg-surface-alt;">
                                    <Label fx:id="auctionStatus" text="OPEN" styleClass="label-bold" style="-fx-text-fill: -success; -fx-font-size: 13px;"/>
                                    <Label text="Status" style="-fx-font-size: 10px;"/>
                                </VBox>
                            </HBox>

                            <!-- Bid Input Area -->
                            <VBox spacing="8">
                                <Label fx:id="minBidHint" text="Min: 0.00" styleClass="body-small" style="-fx-font-size: 12px;"/>
                                <TextField fx:id="bidAmountField" promptText="Amount" styleClass="text-field-base" style="-fx-padding: 10px 14px; -fx-font-size: 14px;"/>
                                <Label fx:id="bidError" text="" styleClass="field-error" style="-fx-min-height: 14px;"/>
                                
                                <HBox spacing="10">
                                    <Button fx:id="placeBidBtn" text="Place Bid" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onPlaceBid" 
                                            styleClass="button btn-primary" style="-fx-padding: 12px; -fx-font-size: 15px; -fx-text-fill: white;"/>
                                    <Button fx:id="watchlistBtn" text="Watch" onAction="#onAddWatchlist" 
                                            styleClass="button btn-outline" style="-fx-padding: 12px 20px; -fx-font-size: 15px; -fx-min-height: 44px;"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- 3. Auto-Bid Form (Dense Grid) -->
                        <VBox styleClass="card" style="-fx-padding: 24px; -fx-background-color: -bg-surface-alt;" spacing="16">
                            <Label text="Auto-Bid Settings" styleClass="label-bold" style="-fx-font-size: 15px;"/>
                            
                            <GridPane hgap="12" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="100"/>
                                </columnConstraints>
                                
                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Max Price" styleClass="body-small" style="-fx-font-size: 11px;"/>
                                    <TextField fx:id="maxPriceField" promptText="1500" styleClass="text-field-base" style="-fx-padding: 10px;"/>
                                </VBox>
                                
                                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Increment" styleClass="body-small" style="-fx-font-size: 11px;"/>
                                    <TextField fx:id="autoBidIncrementField" promptText="50" styleClass="text-field-base" style="-fx-padding: 10px;"/>
                                </VBox>
                                
                                <HBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                    <CheckBox fx:id="aggressiveModeCheckBox" text="Aggressive Mode" style="-fx-font-size: 12px;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="setupAutoBidBtn" text="Activate" onAction="#onSetupAutoBid" 
                                            styleClass="button btn-primary" style="-fx-background-color: -info; -fx-padding: 10px 24px; -fx-font-size: 13px; -fx-min-height: 40px;"/>
                                </HBox>
                            </GridPane>
                            
                            <Label fx:id="autoBidError" text="" styleClass="field-error" style="-fx-min-height: 12px;"/>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
