<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    AuctionDetailView.fxml
    Controller : com.auction.client.controllers.AuctionDetailController
    Màn hình chi tiết sản phẩm đấu giá — hiển thị giá, đồng hồ đếm ngược,
    lịch sử đặt g<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controllers.AuctionDetailController"
            fx:id="rootPane"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ══ TOP NAV ══════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-nav">
            <HBox alignment="CENTER_LEFT" spacing="0" onMouseClicked="#onHome" style="-fx-cursor: hand;">
                <Label text="Auction" styleClass="heading-3" style="-fx-text-fill: -primary; -fx-font-size: 22px;"/>
                <Label text="Hub"     styleClass="heading-3" style="-fx-text-fill: -text-main; -fx-font-size: 22px;"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            
            <HBox alignment="CENTER" spacing="8">
                <Button text="Watchlist" onAction="#onWatchlist" styleClass="btn-ghost"/>
                <Button text="My bids"  onAction="#onMyBids"     styleClass="btn-ghost"/>
                <Button text="+ Sell"   onAction="#onSell"       styleClass="btn-primary"/>
                
                <Separator orientation="VERTICAL" style="-fx-padding: 0 10px;"/>
                
                <Button text="☀/🌙" onAction="#onToggleTheme" styleClass="btn-ghost" style="-fx-font-size: 16px;"/>

                <!-- Wallet Balance Pill -->
                <HBox alignment="CENTER" spacing="8" styleClass="badge" style="-fx-background-color: -primary-light; -fx-padding: 8px 16px;">
                    <Label text="💳" style="-fx-font-size: 14px;"/>
                    <Label fx:id="walletBalanceLabel" text="Loading..." styleClass="label-bold" style="-fx-text-fill: -primary;"/>
                </HBox>

                <Label fx:id="userLabel" text="JD" onMouseClicked="#onProfile" styleClass="badge" style="-fx-background-color: -primary-light; -fx-text-fill: -primary; -fx-padding: 8px 14px; -fx-background-radius: 20px; -fx-cursor: hand;"/>
            </HBox>
        </HBox>
    </top>

    <!-- ══ MAIN CONTENT ═════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24" style="-fx-padding: 30px;">

                <!-- Back link -->
                <Label fx:id="backLabel" text="← Back to listings"
                       onMouseClicked="#onBack"
                       styleClass="body-small"
                       style="-fx-text-fill: -info; -fx-cursor: hand; -fx-font-weight: bold;"/>

                <!-- ── Top section: image + bid panel ──────── -->
                <HBox spacing="24" alignment="TOP_LEFT">

                    <!-- Item image -->
                    <VBox HBox.hgrow="ALWAYS"
                          minWidth="400" minHeight="300"
                          alignment="CENTER"
                          styleClass="card-img-placeholder">
                        <Label text="No image" styleClass="body-text" style="-fx-text-fill: var(--text-muted);"/>
                    </VBox>

                    <!-- Bid panel -->
                    <VBox HBox.hgrow="ALWAYS" spacing="0" maxWidth="400" styleClass="card" style="-fx-padding: 24px;">

                        <!-- Title & category -->
                        <Label fx:id="itemTitle" text="Vintage Rolex Submariner 1969" styleClass="heading-2"/>
                        <Label fx:id="itemMeta" text="Electronics  ·  Seller: watch_king99" styleClass="body-small" style="-fx-padding: 6px 0 20px 0;"/>

                        <Separator style="-fx-opacity: 0.2; -fx-padding: 0 0 20px 0;"/>

                        <!-- Current price -->
                        <Label text="Current highest bid" styleClass="body-small" style="-fx-text-fill: var(--text-secondary);"/>
                        <Label fx:id="currentPrice" text="\$1,240.00" styleClass="heading-1" style="-fx-text-fill: var(--primary); -fx-padding: 4px 0 20px 0;"/>

                        <!-- Stats row -->
                        <HBox spacing="12" style="-fx-padding: 0 0 20px 0;">
                            <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="card-img-placeholder" style="-fx-padding: 10px;">
                                <Label fx:id="totalBids" text="14" styleClass="label-bold" style="-fx-font-size: 16px;"/>
                                <Label text="Bids" styleClass="body-small"/>
                            </VBox>
                            <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="card-img-placeholder" style="-fx-padding: 10px;">
                                <Label fx:id="totalBidders" text="7" styleClass="label-bold" style="-fx-font-size: 16px;"/>
                                <Label text="Bidders" styleClass="body-small"/>
                            </VBox>
                            <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="card-img-placeholder" style="-fx-padding: 10px;">
                                <Label fx:id="auctionStatus" text="OPEN" styleClass="label-bold" style="-fx-text-fill: -success;"/>
                                <Label text="Status" styleClass="body-small"/>
                            </VBox>
                        </HBox>

                        <!-- Countdown timer -->
                        <VBox spacing="4" styleClass="badge" style="-fx-background-color: -warning-light; -fx-padding: 12px 20px; -fx-background-radius: 10px; -fx-margin: 0 0 20px 0;">
                            <Label fx:id="countdownTimer" text="01:47:32" styleClass="heading-2" style="-fx-text-fill: -warning;"/>
                            <Label text="Time remaining" styleClass="body-small" style="-fx-text-fill: -warning; -fx-opacity: 0.8;"/>
                        </VBox>

                        <Region style="-fx-min-height: 20px;"/>

                        <!-- Bid input -->
                        <Label fx:id="minBidHint" text="Minimum bid: &#36;1,260.00" styleClass="body-small" style="-fx-padding: 0 0 8px 0;"/>
                        <TextField fx:id="bidAmountField" promptText="Enter amount" styleClass="text-field-base" maxWidth="Infinity"/>
                        <Label fx:id="bidError" text="" styleClass="field-error" style="-fx-min-height: 18px;"/>

                        <!-- Place bid button -->
                        <Button fx:id="placeBidBtn" text="Place bid" maxWidth="Infinity" onAction="#onPlaceBid" styleClass="button, btn-primary" style="-fx-pref-height: 48px;"/>

                        <Region style="-fx-min-height: 12px;"/>

                        <!-- Auto-Bid section -->
                        <VBox styleClass="card-img-placeholder" style="-fx-padding: 16px;" spacing="12">
                            <Label text="Auto-Bid Settings" styleClass="label-bold"/>
                            <HBox spacing="10">
                                <VBox HBox.hgrow="ALWAYS" spacing="4">
                                    <Label text="Max price" styleClass="body-small"/>
                                    <TextField fx:id="maxPriceField" promptText="e.g. 1500" styleClass="text-field-base"/>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS" spacing="4">
                                    <Label text="Increment" styleClass="body-small"/>
                                    <TextField fx:id="autoBidIncrementField" promptText="e.g. 50" styleClass="text-field-base"/>
                                </VBox>
                            </HBox>
                            <CheckBox fx:id="aggressiveModeCheckBox" text="Aggressive Mode" styleClass="body-small"/>
                            <Button fx:id="setupAutoBidBtn" text="Set Auto-Bid" maxWidth="Infinity" onAction="#onSetupAutoBid" styleClass="button, btn-primary" style="-fx-background-color: -info; -fx-padding: 8px;"/>
                        </VBox>

                        <Region style="-fx-min-height: 12px;"/>

                        <!-- Watchlist button -->
                        <Button fx:id="watchlistBtn" text="Add to watchlist" maxWidth="Infinity" onAction="#onAddWatchlist" styleClass="button, btn-outline"/>
                    </VBox>
                </HBox>

                <!-- ── Item description ──────────────────── -->
                <VBox styleClass="card" style="-fx-padding: 24px;">
                    <Label text="Description" styleClass="heading-3" style="-fx-padding: 0 0 12px 0;"/>
                    <Label fx:id="itemDescription" text="No description provided." styleClass="body-text" style="-fx-line-spacing: 4px;"/>
                </VBox>

                <!-- ── Bid history ───────────────────────── -->
                <VBox styleClass="card" style="-fx-padding: 24px;">
                    <Label text="Bid history" styleClass="heading-3" style="-fx-padding: 0 0 16px 0;"/>
                    <VBox fx:id="bidHistoryList" spacing="0"/>
                    <Label fx:id="noBidsLabel" text="No bids placed yet. Be the first!" styleClass="body-text" style="-fx-text-fill: -text-muted; -fx-padding: 12px 0;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
