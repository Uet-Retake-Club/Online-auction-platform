<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controllers.AuctionDetailController"
            fx:id="rootPane"
            maxWidth="Infinity" maxHeight="Infinity"
            styleClass="auction-detail-root">

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <StackPane alignment="TOP_CENTER">
                <VBox spacing="20" style="-fx-padding: 20px 28px 40px 28px;" maxWidth="Infinity">

                <!-- ── Breadcrumb Bar ─────────────────────── -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="auction-breadcrumb">
                    <Label fx:id="backLabel" text="← Back" onMouseClicked="#onBack"
                           styleClass="breadcrumb-link"/>
                    <Label text="/" style="-fx-text-fill: -text-muted; -fx-font-size: 12px;"/>
                    <Label fx:id="itemMeta" text="Category · Seller" styleClass="body-small"/>
                </HBox>

                <!-- ── Two-Column Grid ────────────────────── -->
                <HBox spacing="30" alignment="TOP_LEFT">

                    <!-- ═══ LEFT: Media + Info ═══════════════ -->
                    <VBox HBox.hgrow="ALWAYS" spacing="16">

                        <!-- Image placeholder card -->
                        <VBox fx:id="imageContainer" alignment="CENTER" styleClass="auction-image-card"
                               minHeight="240" prefHeight="360" maxHeight="450">
                            <Label text="📷" style="-fx-font-size: 36px; -fx-opacity: 0.2;"/>
                            <Label text="No product image available" styleClass="body-small"
                                   style="-fx-text-fill: -text-muted; -fx-padding: 6px 0 0 0;"/>
                        </VBox>

                        <!-- Description card -->
                        <VBox styleClass="card" style="-fx-padding: 22px;" spacing="10">
                            <Label text="Description" styleClass="auction-section-title"/>
                            <Label fx:id="itemDescription" text="No description provided."
                                   styleClass="body-text"
                                   style="-fx-line-spacing: 3px; -fx-font-size: 13px;"
                                   wrapText="true"/>
                        </VBox>

                        <!-- Bid History card -->
                        <VBox spacing="10" styleClass="card" style="-fx-padding: 22px;" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Bid History" styleClass="auction-section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="noBidsLabel" text="No bids yet"
                                       styleClass="badge badge-info" style="-fx-font-size: 11px;"/>
                            </HBox>
                            <ScrollPane fitToWidth="true" styleClass="scroll-pane"
                                        minHeight="120" maxHeight="320" style="-fx-padding: 4px 0 0 0;">
                                <VBox fx:id="bidHistoryList" spacing="6"/>
                            </ScrollPane>
                        </VBox>
                    </VBox>

                    <!-- ═══ RIGHT: Bid Panel ═════════════════ -->
                    <VBox spacing="0" minWidth="380" prefWidth="460" maxWidth="520"
                          styleClass="auction-panel">

                        <!-- ── Main Bid Card ──────────────── -->
                        <VBox spacing="0" styleClass="auction-bid-card">

                            <!-- Title strip -->
                            <VBox style="-fx-padding: 24px 26px 16px 26px;" spacing="4">
                                <Label fx:id="itemTitle" text="Item Title"
                                       styleClass="heading-2"
                                       style="-fx-font-size: 21px;"
                                       wrapText="true"/>
                            </VBox>

                            <!-- Price hero band -->
                            <HBox styleClass="auction-price-band" spacing="0">
                                <VBox HBox.hgrow="ALWAYS" spacing="2" style="-fx-padding: 16px 20px;">
                                    <Label text="CURRENT BID" styleClass="auction-price-label"/>
                                    <Label fx:id="currentPrice" text="\$0.00"
                                           styleClass="auction-price-value"/>
                                </VBox>
                                <Separator orientation="VERTICAL" style="-fx-opacity: 0.15;"/>
                                <VBox spacing="2" alignment="CENTER" style="-fx-padding: 16px 22px;">
                                    <Label text="ENDS IN" styleClass="auction-price-label"/>
                                    <Label fx:id="countdownTimer" text="00:00:00"
                                           styleClass="auction-timer"/>
                                </VBox>
                            </HBox>

                            <!-- Stats strip -->
                            <HBox spacing="0" styleClass="auction-stats-strip">
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="auction-stat">
                                    <Label fx:id="totalBids" text="0" styleClass="auction-stat-value"/>
                                    <Label text="Bids" styleClass="auction-stat-label"/>
                                </VBox>
                                <Separator orientation="VERTICAL" style="-fx-opacity: 0.12;"/>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="auction-stat">
                                    <Label fx:id="totalBidders" text="0" styleClass="auction-stat-value"/>
                                    <Label text="Bidders" styleClass="auction-stat-label"/>
                                </VBox>
                                <Separator orientation="VERTICAL" style="-fx-opacity: 0.12;"/>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="auction-stat">
                                    <Label fx:id="auctionStatus" text="OPEN"
                                           styleClass="auction-stat-value" style="-fx-text-fill: -success;"/>
                                    <Label text="Status" styleClass="auction-stat-label"/>
                                </VBox>
                            </HBox>

                            <!-- Bid form area -->
                            <VBox style="-fx-padding: 20px 26px 26px 26px;" spacing="12">
                                <Label fx:id="minBidHint" text="Minimum bid: $0.00"
                                       styleClass="body-small" style="-fx-text-fill: -text-secondary; -fx-font-size: 12px;"/>
                                <TextField fx:id="bidAmountField" promptText="Enter bid amount"
                                           styleClass="text-field-base auction-bid-input"/>
                                <Label fx:id="bidError" text="" styleClass="field-error"
                                       style="-fx-min-height: 12px;"/>

                                <HBox spacing="10">
                                    <Button fx:id="placeBidBtn" text="Place Bid"
                                            HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                            onAction="#onPlaceBid"
                                            styleClass="button btn-primary auction-bid-btn"/>
                                    <Button fx:id="watchlistBtn" text="♡ Watch"
                                            onAction="#onAddWatchlist"
                                            styleClass="button btn-outline auction-watch-btn"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- ── Auto-Bid Card ──────────────── -->
                        <VBox styleClass="auction-autobid-card" spacing="14"
                              style="-fx-padding: 22px 26px;">

                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="⚡" style="-fx-font-size: 15px;"/>
                                <Label text="Auto-Bid Settings" styleClass="label-bold"
                                       style="-fx-font-size: 13px;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Smart bidding" styleClass="body-small"
                                       style="-fx-text-fill: -text-muted; -fx-font-size: 10px;"/>
                            </HBox>

                            <HBox spacing="10">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Max Price" styleClass="body-small"
                                           style="-fx-font-size: 10px; -fx-text-fill: -text-muted;"/>
                                    <TextField fx:id="maxPriceField" promptText="1500"
                                               styleClass="text-field-base"
                                               style="-fx-padding: 10px 12px; -fx-font-size: 13px;"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Increment" styleClass="body-small"
                                           style="-fx-font-size: 10px; -fx-text-fill: -text-muted;"/>
                                    <TextField fx:id="autoBidIncrementField" promptText="50"
                                               styleClass="text-field-base"
                                               style="-fx-padding: 10px 12px; -fx-font-size: 13px;"/>
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <CheckBox fx:id="aggressiveModeCheckBox" text="Aggressive Mode"
                                          style="-fx-font-size: 12px;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="setupAutoBidBtn" text="Activate"
                                        onAction="#onSetupAutoBid"
                                        styleClass="button btn-primary auction-autobid-btn"/>
                            </HBox>

                            <Label fx:id="autoBidError" text="" styleClass="field-error"
                                   style="-fx-min-height: 10px;"/>
                        </VBox>
                    </VBox>
                </HBox>
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>

</BorderPane>
