<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<!--
    SignUpView.fxml
    Controller : com.auction.client.controllers.SignupController
    CSS        : main.css loaded in ClientApplication.java
    Size       : 900 x 620 — split left/right layout
-->
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.controllers.SignupController"
      fx:id="rootPane"
      maxWidth="Infinity" maxHeight="Infinity">

    <!-- ════════════════════════════════════════════════════
         LEFT PANEL  — dark brand panel
         ════════════════════════════════════════════════════ -->
    <VBox minWidth="280" maxWidth="360"
          alignment="CENTER_LEFT"
          spacing="0"
          styleClass="auth-left-panel"
          style="-fx-padding: 52px 40px;">

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="0" onMouseClicked="#onHome" style="-fx-cursor: hand;">
            <Label text="Auction" styleClass="heading-2" style="-fx-text-fill: -primary; -fx-font-size: 28px;"/>
            <Label text="Hub"     styleClass="heading-2" style="-fx-text-fill: white; -fx-font-size: 28px;"/>
        </HBox>

        <!-- Tagline -->
        <Label text="Join millions of buyers&#10;and sellers worldwide."
               styleClass="body-text"
               style="-fx-text-fill: rgba(255,255,255,0.5); -fx-padding: 8px 0 32px 0; -fx-line-spacing: 4px;"/>

        <!-- Feature bullets -->
        <VBox spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Circle radius="4" fill="#E53238"/>
                <Label text="Free to join" styleClass="body-small" style="-fx-text-fill: rgba(255,255,255,0.75);"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Circle radius="4" fill="#E53238"/>
                <Label text="Bid on any item instantly" styleClass="body-small" style="-fx-text-fill: rgba(255,255,255,0.75);"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Circle radius="4" fill="#E53238"/>
                <Label text="Sell your items easily" styleClass="body-small" style="-fx-text-fill: rgba(255,255,255,0.75);"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Circle radius="4" fill="#E53238"/>
                <Label text="Buyer protection guaranteed" styleClass="body-small" style="-fx-text-fill: rgba(255,255,255,0.75);"/>
            </HBox>
        </VBox>

    </VBox>

    <!-- ════════════════════════════════════════════════════
         RIGHT PANEL — sign-up form
         ════════════════════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS"
          maxWidth="Infinity"
          alignment="CENTER"
          style="-fx-padding: 36px;">

        <!-- White card -->
        <VBox maxWidth="400"
              spacing="0"
              styleClass="card"
              style="-fx-padding: 32px;">

            <!-- Card heading -->
            <Label text="Create your account" styleClass="heading-2"/>
            <Label text="Free, takes under a minute" styleClass="body-small" style="-fx-padding: 4px 0 22px 0;"/>

            <!-- First name + Last name row -->
            <HBox spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="0">
                    <Label text="First name" styleClass="label-bold" style="-fx-padding: 0 0 5px 0;"/>
                    <TextField fx:id="firstNameField" promptText="John" styleClass="text-field-base" maxWidth="Infinity"/>
                    <Label fx:id="firstNameError" text="" styleClass="field-error" style="-fx-min-height: 16px; -fx-padding: 3px 0 8px 0;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="0">
                    <Label text="Last name" styleClass="label-bold" style="-fx-padding: 0 0 5px 0;"/>
                    <TextField fx:id="lastNameField" promptText="Doe" styleClass="text-field-base" maxWidth="Infinity"/>
                    <Label fx:id="lastNameError" text="" styleClass="field-error" style="-fx-min-height: 16px; -fx-padding: 3px 0 8px 0;"/>
                </VBox>
            </HBox>

            <!-- Username -->
            <Label text="Username" styleClass="label-bold" style="-fx-padding: 0 0 5px 0;"/>
            <TextField fx:id="usernameField" promptText="Choose a username" styleClass="text-field-base" maxWidth="Infinity"/>
            <Label fx:id="usernameError" text="" styleClass="field-error" style="-fx-min-height: 16px; -fx-padding: 3px 0 8px 0;"/>

            <!-- Email -->
            <Label text="Email address" styleClass="label-bold" style="-fx-padding: 0 0 5px 0;"/>
            <TextField fx:id="emailField" promptText="you@example.com" styleClass="text-field-base" maxWidth="Infinity"/>
            <Label fx:id="emailError" text="" styleClass="field-error" style="-fx-min-height: 16px; -fx-padding: 3px 0 8px 0;"/>

            <!-- Password -->
            <Label text="Password" styleClass="label-bold" style="-fx-padding: 0 0 5px 0;"/>
            <PasswordField fx:id="passwordField" promptText="At least 8 characters" styleClass="text-field-base" maxWidth="Infinity"/>
            <Label fx:id="passwordError" text="" styleClass="field-error" style="-fx-min-height: 16px; -fx-padding: 3px 0 8px 0;"/>

            <!-- Confirm password -->
            <Label text="Confirm password" styleClass="label-bold" style="-fx-padding: 0 0 5px 0;"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Repeat your password" styleClass="text-field-base" maxWidth="Infinity"/>
            <Label fx:id="confirmPasswordError" text="" styleClass="field-error" style="-fx-min-height: 16px; -fx-padding: 3px 0 6px 0;"/>

            <!-- General error -->
            <Label fx:id="generalError" text="" styleClass="field-error" style="-fx-min-height: 16px; -fx-padding: 0 0 8px 0;"/>

            <!-- Create account button -->
            <Button fx:id="signUpButton"
                    text="Create account"
                    styleClass="button, btn-primary"
                    maxWidth="Infinity"
                    onAction="#onSignUp"
                    style="-fx-pref-height: 42px;"/>

            <!-- Sign in link -->
            <HBox alignment="CENTER" spacing="4" style="-fx-padding: 16px 0 0 0;">
                <Label text="Already have an account?" styleClass="body-small"/>
                <Label fx:id="loginLabel"
                       text="Sign in"
                       styleClass="body-small"
                       style="-fx-text-fill: -info; -fx-cursor: hand;"
                       onMouseClicked="#onGoToLogin"/>
            </HBox>

        </VBox>
    </VBox>

</HBox>
