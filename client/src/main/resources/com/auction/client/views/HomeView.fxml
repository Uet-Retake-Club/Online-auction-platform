<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    HomeView.fxml
    Controller : com.auction.client.controllers.HomeController
    CSS        : main.css loaded in ClientApplication.java
    Size       : 1100 x 700 - full app shell
    Layout     : BorderPane -> top nav / left sidebar / center scroll
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controllers.HomeController"
            fx:id="rootPane"
            maxWidth="Infinity" maxHeight="Infinity">



    <!-- ════════════════════════════════════════════════════
         LEFT SIDEBAR — category navigation
         ════════════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="220" spacing="4" styleClass="sidebar">

            <Label text="CATEGORIES" styleClass="body-small" style="-fx-font-weight: bold; -fx-padding: 0 12px 10px 12px;"/>

            <Button fx:id="allCategoriesBtn" text="All categories"      maxWidth="Infinity" onAction="#onCategoryAll"      styleClass="nav-item-active"/>
            <Button fx:id="electronicsBtn"   text="Electronics"         maxWidth="Infinity" onAction="#onCategoryElectronics" styleClass="nav-item"/>
            <Button fx:id="fashionBtn"       text="Fashion"             maxWidth="Infinity" onAction="#onCategoryFashion"     styleClass="nav-item"/>
            <Button fx:id="homeGardenBtn"    text="Home &amp; Garden"   maxWidth="Infinity" onAction="#onCategoryHome"        styleClass="nav-item"/>
            <Button fx:id="sportsBtn"        text="Sports"              maxWidth="Infinity" onAction="#onCategorySports"      styleClass="nav-item"/>
            <Button fx:id="collectiblesBtn"  text="Collectibles"        maxWidth="Infinity" onAction="#onCategoryCollectibles" styleClass="nav-item"/>
            <Button fx:id="vehiclesBtn"      text="Vehicles"            maxWidth="Infinity" onAction="#onCategoryVehicles"     styleClass="nav-item"/>
            <Button fx:id="otherBtn"         text="Other"               maxWidth="Infinity" onAction="#onCategoryOther"        styleClass="nav-item"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator style="-fx-opacity: 0.3; -fx-padding: 10px 0;"/>

            <Button fx:id="profileBtn" text="My profile" maxWidth="Infinity" onAction="#onProfile" styleClass="nav-item"/>
            <Button fx:id="logoutBtn"  text="Sign out"   maxWidth="Infinity" onAction="#onLogout"  styleClass="nav-item"/>

        </VBox>
    </left>

    <!-- ════════════════════════════════════════════════════
         CENTER — scrollable main content
         ════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="30" style="-fx-padding: 30px;">

                <!-- Search bar -->
                <HBox alignment="CENTER" maxWidth="600" styleClass="search-bar-container">
                    <TextField fx:id="searchField"
                               promptText="Search for anything..."
                               HBox.hgrow="ALWAYS"
                               styleClass="search-field"
                               onAction="#onSearch"/>
                    <Button text="Search"
                            onAction="#onSearch"
                            styleClass="button, btn-primary"
                            style="-fx-background-radius: 0 24px 24px 0; -fx-padding: 8px 24px;"/>
                </HBox>

                <!-- ── Section: Ending Soon ─────────────────── -->
                <VBox spacing="15">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Ending soon" styleClass="heading-3" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label fx:id="seeAllEndingSoon" text="See all" onMouseClicked="#onSeeAllEndingSoon" styleClass="body-small" style="-fx-text-fill: -info; -fx-cursor: hand;"/>
                    </HBox>
                    <FlowPane fx:id="endingSoonGrid" hgap="16" vgap="16"/>
                </VBox>

                <Separator style="-fx-opacity: 0.3;"/>

                <!-- ── Section: Recently Listed ───────────────  -->
                <VBox spacing="15">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Recently listed" styleClass="heading-3" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label fx:id="seeAllRecent" text="See all" onMouseClicked="#onSeeAllRecent" styleClass="body-small" style="-fx-text-fill: -info; -fx-cursor: hand;"/>
                    </HBox>
                    <FlowPane fx:id="recentGrid" hgap="16" vgap="16"/>
                </VBox>

                <!-- ── Empty state (hidden until no results) ── -->
                <VBox fx:id="emptyState" alignment="CENTER" spacing="15" visible="false" managed="false" style="-fx-padding: 80px 0;">
                    <Label text="No auctions found" styleClass="heading-2" style="-fx-text-fill: -text-secondary;"/>
                    <Label text="Try a different search term or browse a category." styleClass="body-text" style="-fx-text-fill: -text-muted;"/>
                    <Button text="Clear search" onAction="#onClearSearch" styleClass="button, btn-outline"/>
                </VBox>

                <!-- ── Loading state (hidden until fetching) ── -->
                <VBox fx:id="loadingState" alignment="CENTER" spacing="15" visible="false" managed="false" style="-fx-padding: 80px 0;">
                    <ProgressIndicator style="-fx-progress-color: -primary;" prefWidth="48" prefHeight="48"/>
                    <Label text="Loading auctions..." styleClass="body-text" style="-fx-text-fill: -text-muted;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
