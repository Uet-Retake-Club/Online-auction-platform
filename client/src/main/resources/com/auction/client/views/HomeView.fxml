<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    HomeView.fxml
    Controller : com.auction.client.controllers.HomeController
    CSS        : main.css loaded in ClientApplication.java
    Size       : 1100 x 700 - full app shell
    Layout     : BorderPane -> top nav / left sidebar / center scroll
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controllers.HomeController"
            fx:id="rootPane"
            maxWidth="Infinity" maxHeight="Infinity"
            style="-fx-background-color: #F4F4F4;">

    <!-- ════════════════════════════════════════════════════
         TOP NAVIGATION BAR
         ════════════════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              style="-fx-background-color: white;
                     -fx-border-color: transparent transparent #EBEBEB transparent;
                     -fx-border-width: 0 0 1px 0;
                     -fx-padding: 10px 20px;">

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="0" onMouseClicked="#onHome" style="-fx-cursor: hand;">
                <Label text="Auction"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-text-fill: #E53238; -fx-font-family: 'Segoe UI';"/>
                <Label text="Hub"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-text-fill: #111111; -fx-font-family: 'Segoe UI';"/>
            </HBox>

            <!-- Search bar -->
            <HBox alignment="CENTER" HBox.hgrow="ALWAYS" maxWidth="500">
                <TextField fx:id="searchField"
                           promptText="Search for anything..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: white;
                                  -fx-border-color: #E0E0E0 transparent #E0E0E0 #E0E0E0;
                                  -fx-border-width: 1.5px 0 1.5px 1.5px;
                                  -fx-border-radius: 24px 0 0 24px;
                                  -fx-background-radius: 24px 0 0 24px;
                                  -fx-padding: 8px 18px;
                                  -fx-font-size: 13px;
                                  -fx-font-family: 'Segoe UI';"
                           onAction="#onSearch"/>
                <Button text="Search"
                        onAction="#onSearch"
                        style="-fx-background-color: #E53238;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 13px;
                               -fx-border-radius: 0 24px 24px 0;
                               -fx-background-radius: 0 24px 24px 0;
                               -fx-padding: 8px 18px;
                               -fx-cursor: hand;
                               -fx-effect: null;"/>
            </HBox>

            <!-- Push nav actions to the right -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Watchlist -->
            <Button fx:id="watchlistBtn"
                    text="Watchlist"
                    onAction="#onWatchlist"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-border-color: transparent;
                           -fx-border-radius: 6px;
                           -fx-background-radius: 6px;
                           -fx-padding: 7px 12px;
                           -fx-cursor: hand;
                           -fx-effect: null;"/>

            <!-- My bids -->
            <Button fx:id="myBidsBtn"
                    text="My bids"
                    onAction="#onMyBids"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-border-color: transparent;
                           -fx-border-radius: 6px;
                           -fx-background-radius: 6px;
                           -fx-padding: 7px 12px;
                           -fx-cursor: hand;
                           -fx-effect: null;"/>

            <!-- Admin panel -->
            <Button fx:id="adminBtn"
                    text="🛡 Admin"
                    onAction="#onAdmin"
                    visible="false" managed="false"
                    style="-fx-background-color: #1A73E8;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-font-size: 13px;
                           -fx-border-color: transparent;
                           -fx-border-radius: 6px;
                           -fx-background-radius: 6px;
                           -fx-padding: 7px 14px;
                           -fx-cursor: hand;
                           -fx-effect: null;"/>

            <!-- Sell button -->
            <Button fx:id="sellBtn"
                    text="+ Sell"
                    onAction="#onSell"
                    style="-fx-background-color: #E53238;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-font-size: 13px;
                           -fx-border-color: transparent;
                           -fx-border-radius: 6px;
                           -fx-background-radius: 6px;
                           -fx-padding: 7px 14px;
                           -fx-cursor: hand;
                           -fx-effect: null;"/>

            <!-- User avatar pill -->
                        <Button text="☀/🌙" onAction="#onToggleTheme"
                    style="-fx-background-color:transparent;-fx-border-color:transparent;-fx-text-fill:#555;-fx-font-size:16px;-fx-cursor:hand;-fx-effect:null;-fx-padding:0 8px;"/>
            <Label fx:id="userLabel"
                   text="JD"
                   onMouseClicked="#onProfile"
                   style="-fx-background-color: #FDECEA;
                          -fx-text-fill: #E53238;
                          -fx-font-weight: bold;
                          -fx-font-size: 12px;
                          -fx-font-family: 'Segoe UI';
                          -fx-padding: 7px 13px;
                          -fx-background-radius: 20px;
                          -fx-cursor: hand;"/>

        </HBox>
    </top>

    <!-- ════════════════════════════════════════════════════
         LEFT SIDEBAR — category navigation
         ════════════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="190"
              spacing="3"
              style="-fx-background-color: white;
                     -fx-border-color: transparent #EBEBEB transparent transparent;
                     -fx-border-width: 0 1px 0 0;
                     -fx-padding: 18px 10px;">

            <!-- Section label -->
            <Label text="CATEGORIES"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #AAAAAA; -fx-font-family: 'Segoe UI';
                          -fx-padding: 0 8px 8px 8px;"/>

            <!-- Category buttons -->
            <Button fx:id="allCategoriesBtn" text="All categories"
                    maxWidth="Infinity" onAction="#onCategoryAll"
                    styleClass="nav-item-active"
                    style="-fx-effect: null;"/>
            <Button fx:id="electronicsBtn"   text="Electronics"
                    maxWidth="Infinity" onAction="#onCategoryElectronics"
                    styleClass="nav-item"
                    style="-fx-effect: null;"/>
            <Button fx:id="fashionBtn"       text="Fashion"
                    maxWidth="Infinity" onAction="#onCategoryFashion"
                    styleClass="nav-item"
                    style="-fx-effect: null;"/>
            <Button fx:id="homeGardenBtn"    text="Home &amp; Garden"
                    maxWidth="Infinity" onAction="#onCategoryHome"
                    styleClass="nav-item"
                    style="-fx-effect: null;"/>
            <Button fx:id="sportsBtn"        text="Sports"
                    maxWidth="Infinity" onAction="#onCategorySports"
                    styleClass="nav-item"
                    style="-fx-effect: null;"/>
            <Button fx:id="collectiblesBtn"  text="Collectibles"
                    maxWidth="Infinity" onAction="#onCategoryCollectibles"
                    styleClass="nav-item"
                    style="-fx-effect: null;"/>
            <Button fx:id="vehiclesBtn"      text="Vehicles"
                    maxWidth="Infinity" onAction="#onCategoryVehicles"
                    styleClass="nav-item"
                    style="-fx-effect: null;"/>
            <Button fx:id="otherBtn"         text="Other"
                    maxWidth="Infinity" onAction="#onCategoryOther"
                    styleClass="nav-item"
                    style="-fx-effect: null;"/>

            <!-- Push profile/logout to bottom -->
            <Region VBox.vgrow="ALWAYS"/>

            <Separator style="-fx-opacity: 0.5;"/>

            <Button fx:id="profileBtn" text="My profile"
                    maxWidth="Infinity" onAction="#onProfile"
                    styleClass="nav-item"
                    style="-fx-effect: null;"/>
            <Button fx:id="logoutBtn"  text="Sign out"
                    maxWidth="Infinity" onAction="#onLogout"
                    styleClass="nav-item"
                    style="-fx-effect: null;"/>

        </VBox>
    </left>

    <!-- ════════════════════════════════════════════════════
         CENTER — scrollable main content
         ════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="scroll-pane">
            <VBox spacing="0"
                  style="-fx-padding: 22px;">

                <!-- ── Section: Ending Soon ─────────────────── -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-padding: 0 0 12px 0;">
                    <Label text="Ending soon"
                           HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 15px; -fx-font-weight: bold;
                                  -fx-text-fill: #111111; -fx-font-family: 'Segoe UI';"/>
                    <Label fx:id="seeAllEndingSoon"
                           text="See all"
                           onMouseClicked="#onSeeAllEndingSoon"
                           style="-fx-font-size: 12px; -fx-text-fill: #1A73E8;
                                  -fx-cursor: hand; -fx-font-family: 'Segoe UI';"/>
                </HBox>

                <!-- Cards grid — HomeController adds VBox cards here -->
                <FlowPane fx:id="endingSoonGrid"
                          hgap="14" vgap="14"
                          style="-fx-padding: 0 0 24px 0;"/>

                <!-- ── Divider ──────────────────────────────── -->
                <Separator style="-fx-opacity: 0.6; -fx-padding: 0 0 22px 0;"/>

                <Region style="-fx-min-height: 20px; -fx-pref-height: 20px;"/>

                <!-- ── Section: Recently Listed ───────────────  -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-padding: 0 0 12px 0;">
                    <Label text="Recently listed"
                           HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 15px; -fx-font-weight: bold;
                                  -fx-text-fill: #111111; -fx-font-family: 'Segoe UI';"/>
                    <Label fx:id="seeAllRecent"
                           text="See all"
                           onMouseClicked="#onSeeAllRecent"
                           style="-fx-font-size: 12px; -fx-text-fill: #1A73E8;
                                  -fx-cursor: hand; -fx-font-family: 'Segoe UI';"/>
                </HBox>

                <FlowPane fx:id="recentGrid"
                          hgap="14" vgap="14"
                          style="-fx-padding: 0 0 24px 0;"/>

                <!-- ── Empty state (hidden until no results) ── -->
                <VBox fx:id="emptyState"
                      alignment="CENTER"
                      spacing="10"
                      visible="false" managed="false"
                      style="-fx-padding: 60px 0;">
                    <Label text="No auctions found"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;
                                  -fx-text-fill: #767676; -fx-font-family: 'Segoe UI';"/>
                    <Label text="Try a different search term or browse a category."
                           style="-fx-font-size: 13px; -fx-text-fill: #AAAAAA;
                                  -fx-font-family: 'Segoe UI';"/>
                    <Button text="Clear search"
                            onAction="#onClearSearch"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #333333;
                                   -fx-border-color: #E0E0E0;
                                   -fx-border-width: 1.5px;
                                   -fx-border-radius: 6px;
                                   -fx-background-radius: 6px;
                                   -fx-padding: 8px 20px;
                                   -fx-cursor: hand;
                                   -fx-font-size: 13px;
                                   -fx-effect: null;"/>
                </VBox>

                <!-- ── Loading state (hidden until fetching) ── -->
                <VBox fx:id="loadingState"
                      alignment="CENTER"
                      spacing="12"
                      visible="false" managed="false"
                      style="-fx-padding: 60px 0;">
                    <ProgressIndicator
                           style="-fx-progress-color: #E53238;"
                           prefWidth="44" prefHeight="44"/>
                    <Label text="Loading auctions..."
                           style="-fx-font-size: 13px; -fx-text-fill: #AAAAAA;
                                  -fx-font-family: 'Segoe UI';"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
