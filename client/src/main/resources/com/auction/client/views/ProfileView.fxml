<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controllers.ProfileController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #F4F4F4;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: white; -fx-border-color: transparent transparent #EBEBEB transparent; -fx-border-width: 0 0 1px 0; -fx-padding: 12px 20px;">
            <Label text="Auction" style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:#E53238;"/>
            <Label text="Hub" style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:#111111;"/>
            <Region HBox.hgrow="ALWAYS"/>
                        <Button text="☀/🌙" onAction="#onToggleTheme"
                    style="-fx-background-color:transparent;-fx-border-color:transparent;-fx-text-fill:#555;-fx-font-size:16px;-fx-cursor:hand;-fx-effect:null;-fx-padding:0 8px;"/>
            <Button text="Wallet" onAction="#onWallet"
                    style="-fx-background-color:transparent;-fx-border-color:transparent;-fx-text-fill:#555;-fx-font-size:13px;-fx-cursor:hand;-fx-effect:null;-fx-padding:7px 12px;"/>
            <Label fx:id="userLabel" text="JD"
                   style="-fx-background-color:#FDECEA;-fx-text-fill:#E53238;-fx-font-weight:bold;-fx-font-size:12px;-fx-padding:7px 13px;-fx-background-radius:20px;"/>
            <Button text="Sign out" onAction="#onLogout"
                    style="-fx-background-color:transparent;-fx-text-fill:#555;-fx-border-color:transparent;-fx-font-size:13px;-fx-cursor:hand;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="22" style="-fx-padding: 24px;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="← Back" onMouseClicked="#onBack"
                           style="-fx-text-fill:#1A73E8;-fx-font-size:13px;-fx-cursor:hand;"/>
                    <Label fx:id="userTitle" text="My Profile"
                           style="-fx-font-size:24px;-fx-font-weight:bold;-fx-text-fill:#111;"/>
                </HBox>

                <VBox spacing="18" style="-fx-background-color:white;-fx-border-color:#EBEBEB;-fx-border-radius:10px;-fx-background-radius:10px;-fx-padding:24px;">
                    <Label text="Your account details"
                           style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#111;"/>

                    <GridPane hgap="20" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="30"/>
                            <ColumnConstraints percentWidth="70"/>
                        </columnConstraints>

                        <Label text="First name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="firstNameField" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="text-field-base"/>

                        <Label text="Last name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="lastNameField" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="text-field-base"/>

                        <Label text="Username:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="usernameField" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="text-field-base"/>

                        <Label text="Email address:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="text-field-base"/>

                        <Label text="Role:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="roleField" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="text-field-base" editable="false"/>
                    </GridPane>

                    <Label fx:id="statusLabel" text="" style="-fx-font-size:12px;"/>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button fx:id="saveBtn" text="Save changes" onAction="#onSave"
                                style="-fx-background-color:#E53238;-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:14px;-fx-border-color:transparent;-fx-border-radius:6px;-fx-background-radius:6px;-fx-padding:10px 18px;-fx-cursor:hand;"/>
                        <Button text="Cancel" onAction="#onBack"
                                style="-fx-background-color:white;-fx-text-fill:#555;-fx-border-color:#E0E0E0;-fx-border-radius:6px;-fx-background-radius:6px;-fx-padding:10px 18px;-fx-cursor:hand;"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
