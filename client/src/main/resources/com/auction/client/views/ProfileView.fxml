<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    ProfileView.fxml
    Controller : com.auction.client.controllers.ProfileController
    Shows user profile details + wallet balance with top-up
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controllers.ProfileController"
            maxWidth="Infinity" maxHeight="Infinity"
            style="-fx-background-color: #F4F4F4;">

    <!-- ═══════════════════════════════════ TOP NAV ═══════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: white;
                     -fx-border-color: transparent transparent #EBEBEB transparent;
                     -fx-border-width: 0 0 1px 0;
                     -fx-padding: 10px 20px;">

            <!-- Logo (clickable → home) -->
            <HBox alignment="CENTER_LEFT" spacing="0" onMouseClicked="#onHome" style="-fx-cursor: hand;">
                <Label text="Auction"
                       style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:#E53238;-fx-font-family:'Segoe UI';"/>
                <Label text="Hub"
                       style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:#111111;-fx-font-family:'Segoe UI';"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Theme toggle -->
            <Button text="☀/🌙" onAction="#onToggleTheme"
                    style="-fx-background-color:transparent;-fx-border-color:transparent;-fx-text-fill:#555;-fx-font-size:16px;-fx-cursor:hand;-fx-effect:null;-fx-padding:0 8px;"/>

            <!-- User avatar -->
            <Label fx:id="userLabel" text="JD" onMouseClicked="#onProfile"
                   style="-fx-background-color:#FDECEA;-fx-text-fill:#E53238;
                          -fx-font-weight:bold;-fx-font-size:12px;-fx-font-family:'Segoe UI';
                          -fx-padding:7px 13px;-fx-background-radius:20px;-fx-cursor:hand;"/>

            <!-- Sign out -->
            <Button text="Sign out" onAction="#onLogout"
                    style="-fx-background-color:transparent;-fx-text-fill:#555;-fx-border-color:transparent;
                           -fx-font-size:13px;-fx-cursor:hand;-fx-effect:null;"/>
        </HBox>
    </top>

    <!-- ═══════════════════════════════ CENTER CONTENT ═══════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 28px;">

                <!-- Back + page title -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="← Back" onMouseClicked="#onBack"
                           style="-fx-text-fill:#1A73E8;-fx-font-size:13px;-fx-cursor:hand;-fx-font-family:'Segoe UI';"/>
                    <Label fx:id="userTitle" text="My Profile"
                           style="-fx-font-size:24px;-fx-font-weight:bold;-fx-text-fill:#111;-fx-font-family:'Segoe UI';"/>
                </HBox>

                <!-- ───────────── Wallet Card ───────────── -->
                <VBox spacing="0"
                      style="-fx-background-color:#1a1a2e;
                             -fx-background-radius:14px;
                             -fx-border-radius:14px;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.22), 16, 0, 0, 6);
                             -fx-padding: 0;">

                    <!-- Card gradient header -->
                    <HBox alignment="CENTER_LEFT" spacing="16"
                          style="-fx-padding: 22px 24px 18px 24px;">

                        <!-- Wallet icon circle -->
                        <StackPane style="-fx-background-color:rgba(255,255,255,0.12);
                                         -fx-background-radius:50%;
                                         -fx-min-width:52px; -fx-pref-width:52px;
                                         -fx-min-height:52px; -fx-pref-height:52px;">
                            <Label text="💳"
                                   style="-fx-font-size:24px;"/>
                        </StackPane>

                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="MY WALLET"
                                   style="-fx-font-size:11px;-fx-font-weight:bold;
                                          -fx-text-fill:rgba(255,255,255,0.6);
                                          -fx-font-family:'Segoe UI';
                                          -fx-letter-spacing:1px;"/>
                            <Label fx:id="walletBalanceLabel" text="Loading..."
                                   style="-fx-font-size:32px;-fx-font-weight:bold;
                                          -fx-text-fill:white;-fx-font-family:'Segoe UI';"/>
                            <Label text="Available balance"
                                   style="-fx-font-size:12px;-fx-text-fill:rgba(255,255,255,0.55);-fx-font-family:'Segoe UI';"/>
                        </VBox>

                        <!-- Refresh button -->
                        <Button text="⟳ Refresh" onAction="#onRefreshWallet"
                                style="-fx-background-color:rgba(255,255,255,0.12);
                                       -fx-text-fill:white;
                                       -fx-font-size:12px;
                                       -fx-border-color:rgba(255,255,255,0.25);
                                       -fx-border-radius:20px;
                                       -fx-background-radius:20px;
                                       -fx-padding:7px 16px;
                                       -fx-cursor:hand;
                                       -fx-effect:null;"/>
                    </HBox>

                    <!-- Divider -->
                    <Region style="-fx-background-color:rgba(255,255,255,0.08);-fx-min-height:1px;-fx-pref-height:1px;"/>

                    <!-- Top-up row -->
                    <HBox alignment="CENTER_LEFT" spacing="10"
                          style="-fx-padding: 16px 24px 20px 24px;">
                        <Label text="Top up:"
                               style="-fx-font-size:13px;-fx-text-fill:rgba(255,255,255,0.7);-fx-font-family:'Segoe UI';"/>
                        <TextField fx:id="topUpField"
                                   promptText="Enter amount (e.g. 100)"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color:rgba(255,255,255,0.10);
                                          -fx-border-color:rgba(255,255,255,0.25);
                                          -fx-border-width:1.5px;
                                          -fx-border-radius:8px;
                                          -fx-background-radius:8px;
                                          -fx-text-fill:white;
                                          -fx-prompt-text-fill:rgba(255,255,255,0.4);
                                          -fx-font-size:13px;
                                          -fx-padding:8px 14px;
                                          -fx-effect:null;"/>
                        <Button text="Request Top-up" onAction="#onTopUp"
                                style="-fx-background-color:#E53238;
                                       -fx-text-fill:white;
                                       -fx-font-weight:bold;
                                       -fx-font-size:13px;
                                       -fx-border-color:transparent;
                                       -fx-border-radius:8px;
                                       -fx-background-radius:8px;
                                       -fx-padding:9px 18px;
                                       -fx-cursor:hand;
                                       -fx-effect:null;"/>
                    </HBox>

                    <!-- Status line for wallet -->
                    <Label fx:id="walletStatusLabel" text=""
                           style="-fx-font-size:12px;-fx-padding:0 24px 14px 24px;
                                  -fx-text-fill:rgba(255,255,255,0.75);-fx-font-family:'Segoe UI';"/>
                </VBox>

                <!-- ───────────── Profile Details Card ───────────── -->
                <VBox spacing="18"
                      style="-fx-background-color:white;
                             -fx-border-color:#EBEBEB;
                             -fx-border-radius:12px;
                             -fx-background-radius:12px;
                             -fx-padding:26px;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3);">

                    <Label text="Account Details"
                           style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#111;-fx-font-family:'Segoe UI';"/>

                    <GridPane hgap="20" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="140"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="First name" GridPane.rowIndex="0" GridPane.columnIndex="0"
                               style="-fx-font-size:13px;-fx-text-fill:#767676;-fx-font-family:'Segoe UI';"/>
                        <TextField fx:id="firstNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                   styleClass="text-field-base"/>

                        <Label text="Last name" GridPane.rowIndex="1" GridPane.columnIndex="0"
                               style="-fx-font-size:13px;-fx-text-fill:#767676;-fx-font-family:'Segoe UI';"/>
                        <TextField fx:id="lastNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                   styleClass="text-field-base"/>

                        <Label text="Username" GridPane.rowIndex="2" GridPane.columnIndex="0"
                               style="-fx-font-size:13px;-fx-text-fill:#767676;-fx-font-family:'Segoe UI';"/>
                        <TextField fx:id="usernameField" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                   styleClass="text-field-base"/>

                        <Label text="Email" GridPane.rowIndex="3" GridPane.columnIndex="0"
                               style="-fx-font-size:13px;-fx-text-fill:#767676;-fx-font-family:'Segoe UI';"/>
                        <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1"
                                   styleClass="text-field-base"/>

                        <Label text="Role" GridPane.rowIndex="4" GridPane.columnIndex="0"
                               style="-fx-font-size:13px;-fx-text-fill:#767676;-fx-font-family:'Segoe UI';"/>
                        <TextField fx:id="roleField" GridPane.rowIndex="4" GridPane.columnIndex="1"
                                   styleClass="text-field-base" editable="false"
                                   style="-fx-opacity:0.7;"/>
                    </GridPane>

                    <!-- Inline status message -->
                    <Label fx:id="statusLabel" text=""
                           style="-fx-font-size:12px;-fx-font-family:'Segoe UI';"/>

                    <!-- Action buttons -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button fx:id="saveBtn" text="Save changes" onAction="#onSave"
                                style="-fx-background-color:#E53238;-fx-text-fill:white;
                                       -fx-font-weight:bold;-fx-font-size:14px;
                                       -fx-border-color:transparent;
                                       -fx-border-radius:8px;-fx-background-radius:8px;
                                       -fx-padding:10px 22px;-fx-cursor:hand;-fx-effect:null;"/>
                        <Button text="Cancel" onAction="#onBack"
                                style="-fx-background-color:white;-fx-text-fill:#555;
                                       -fx-border-color:#E0E0E0;-fx-border-width:1.5px;
                                       -fx-border-radius:8px;-fx-background-radius:8px;
                                       -fx-padding:10px 22px;-fx-cursor:hand;-fx-effect:null;"/>
                    </HBox>
                </VBox>

                <!-- ───────────── Wallet History Card ───────────── -->
                <VBox spacing="18"
                      style="-fx-background-color:white;
                             -fx-border-color:#EBEBEB;
                             -fx-border-radius:12px;
                             -fx-background-radius:12px;
                             -fx-padding:26px;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3);">

                    <Label text="Transaction History"
                           style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#111;-fx-font-family:'Segoe UI';"/>

                    <TableView fx:id="historyTable" prefHeight="250" style="-fx-background-color: transparent;">
                        <columns>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="180"/>
                            <TableColumn fx:id="colAmount" text="Amount" prefWidth="120"/>
                            <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
