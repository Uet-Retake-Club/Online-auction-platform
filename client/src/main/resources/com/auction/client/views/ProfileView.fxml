<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    ProfileView.fxml
    Controller : com.auction.client.controllers.ProfileController
    Shows user profile details + wallet balance with top-up
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controllers.ProfileController"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ═══════════════════════════════════ TOP NAV ═══════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-nav">
            <HBox alignment="CENTER_LEFT" spacing="0" onMouseClicked="#onHome" style="-fx-cursor: hand;">
                <Label text="Auction" styleClass="heading-3" style="-fx-text-fill: -primary; -fx-font-size: 22px;"/>
                <Label text="Hub"     styleClass="heading-3" style="-fx-text-fill: -text-main; -fx-font-size: 22px;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="☀/🌙" onAction="#onToggleTheme" styleClass="btn-ghost" style="-fx-font-size: 16px;"/>

            <Label fx:id="userLabel" text="JD" onMouseClicked="#onProfile"
                   styleClass="badge"
                   style="-fx-background-color: -primary-light; -fx-text-fill: -primary; -fx-padding: 8px 14px; -fx-background-radius: 20px; -fx-cursor: hand;"/>

            <Button text="Sign out" onAction="#onLogout" styleClass="btn-ghost"/>
        </HBox>
    </top>

    <!-- ═══════════════════════════════ CENTER CONTENT ═══════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="30" alignment="TOP_CENTER" style="-fx-padding: 30px;">

                <!-- Back + page title -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="← Back" onMouseClicked="#onBack" styleClass="body-small" style="-fx-text-fill: -info; -fx-cursor: hand; -fx-font-weight: bold;"/>
                    <Label fx:id="userTitle" text="My Profile" styleClass="heading-1"/>
                </HBox>

                <!-- ───────────── Wallet Card ───────────── -->
                <VBox spacing="0" styleClass="auth-left-panel" style="-fx-padding: 0; -fx-background-radius: 20px;">

                    <!-- Card header -->
                    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 30px;">
                        <StackPane style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 50%; -fx-min-width: 60px; -fx-min-height: 60px;">
                            <Label text="💳" style="-fx-font-size: 28px;"/>
                        </StackPane>

                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="MY WALLET" styleClass="body-small" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                            <Label fx:id="walletBalanceLabel" text="Loading..." styleClass="heading-1" style="-fx-text-fill: white; -fx-font-size: 36px;"/>
                            <Label text="Available balance" styleClass="body-small" style="-fx-text-fill: rgba(255,255,255,0.5);"/>
                        </VBox>

                        <Button text="⟳ Refresh" onAction="#onRefreshWallet" styleClass="button" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 20px; -fx-background-radius: 20px; -fx-padding: 8px 16px;"/>
                    </HBox>

                    <Separator style="-fx-opacity: 0.1;"/>

                    <!-- Top-up row -->
                    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20px 30px 30px 30px;">
                        <Label text="Top up:" styleClass="body-text" style="-fx-text-fill: white;"/>
                        <TextField fx:id="topUpField" promptText="Enter amount" HBox.hgrow="ALWAYS" styleClass="text-field-base" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-border-color: rgba(255,255,255,0.2);"/>
                        <Button text="Request Top-up" onAction="#onTopUp" styleClass="button, btn-primary" style="-fx-padding: 10px 24px;"/>
                    </HBox>

                    <Label fx:id="walletStatusLabel" text="" styleClass="body-small" style="-fx-padding: 0 30px 20px 30px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                </VBox>

                <!-- ───────────── Profile Details Card ───────────── -->
                <VBox spacing="24" styleClass="card" style="-fx-padding: 30px;">
                    <Label text="Account Details" styleClass="heading-2"/>

                    <GridPane hgap="30" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="First name" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-bold"/>
                        <TextField fx:id="firstNameField" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="text-field-base"/>

                        <Label text="Last name" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-bold"/>
                        <TextField fx:id="lastNameField" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="text-field-base"/>

                        <Label text="Username" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-bold"/>
                        <TextField fx:id="usernameField" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="text-field-base"/>

                        <Label text="Email" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="label-bold"/>
                        <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="text-field-base"/>

                        <Label text="Role" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="label-bold"/>
                        <TextField fx:id="roleField" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="text-field-base" editable="false" style="-fx-opacity: 0.6;"/>
                    </GridPane>

                    <Label fx:id="statusLabel" text="" styleClass="body-small"/>

                    <HBox spacing="15">
                        <Button fx:id="saveBtn" text="Save changes" onAction="#onSave" styleClass="button, btn-primary" style="-fx-padding: 12px 32px;"/>
                        <Button text="Cancel" onAction="#onBack" styleClass="button, btn-outline" style="-fx-padding: 12px 32px;"/>
                    </HBox>
                </VBox>

                <!-- ───────────── Wallet History Card ───────────── -->
                <VBox spacing="24" styleClass="card" style="-fx-padding: 30px;">
                    <Label text="Transaction History" styleClass="heading-2"/>
                    <TableView fx:id="historyTable" prefHeight="300" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colDate"   text="Date"   prefWidth="200"/>
                            <TableColumn fx:id="colAmount" text="Amount" prefWidth="150"/>
                            <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
