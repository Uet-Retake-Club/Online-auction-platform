<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    AdminView.fxml
    Controller : com.auction.client.controllers.AdminController
    System Administration Screen - statistics, user management, auction management.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controllers.AdminController"
            fx:id="rootPane"
            maxWidth="Infinity" maxHeight="Infinity">



    <!-- ══ LEFT SIDEBAR ════════════════════════════════════ -->
    <left>
        <VBox prefWidth="220" spacing="4" styleClass="sidebar">
            <Label text="ADMIN PANEL" styleClass="body-small" style="-fx-font-weight: bold; -fx-padding: 0 12px 10px 12px;"/>
            
            <Button fx:id="navDashboard"  text="Dashboard"  maxWidth="Infinity" onAction="#onTabDashboard" styleClass="nav-item-active"/>
            <Button fx:id="navUsers"      text="Users"      maxWidth="Infinity" onAction="#onTabUsers"     styleClass="nav-item"/>
            <Button fx:id="navAuctions"   text="Auctions"   maxWidth="Infinity" onAction="#onTabAuctions"  styleClass="nav-item"/>
            <Button fx:id="navBids"       text="Bids"       maxWidth="Infinity" onAction="#onTabBids"      styleClass="nav-item"/>
            <Button fx:id="navWallet"     text="Wallet Approval" maxWidth="Infinity" onAction="#onTabWallet" styleClass="nav-item"/>
        </VBox>
    </left>

    <!-- ══ MAIN CONTENT ═════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="30" style="-fx-padding: 30px;">

                <!-- ── DASHBOARD TAB ──────────────────────── -->
                <VBox fx:id="dashboardTab" spacing="24">
                    <!-- Stat cards row -->
                    <HBox spacing="16">
                        <VBox HBox.hgrow="ALWAYS" styleClass="card" style="-fx-padding: 20px;">
                            <Label fx:id="statTotalUsers" text="..." styleClass="heading-1"/>
                            <Label text="Total users" styleClass="body-small" style="-fx-text-fill: -text-secondary;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" styleClass="card" style="-fx-padding: 20px;">
                            <Label fx:id="statActiveAuctions" text="..." styleClass="heading-1"/>
                            <Label text="Active auctions" styleClass="body-small" style="-fx-text-fill: -text-secondary;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" styleClass="card" style="-fx-padding: 20px;">
                            <Label fx:id="statTotalBids" text="..." styleClass="heading-1"/>
                            <Label text="Total bids" styleClass="body-small" style="-fx-text-fill: -text-secondary;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" styleClass="card" style="-fx-padding: 20px;">
                            <Label fx:id="statRevenue" text="..." styleClass="heading-1" style="-fx-text-fill: -success;"/>
                            <Label text="Total Revenue" styleClass="body-small" style="-fx-text-fill: -text-secondary;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="24">
                        <VBox HBox.hgrow="ALWAYS" spacing="12" styleClass="card" style="-fx-padding: 24px;">
                            <Label text="Quick Actions" styleClass="heading-3"/>
                            <HBox spacing="10">
                                <Button text="Manage Users" onAction="#onTabUsers" styleClass="button, btn-primary" style="-fx-font-size: 12px;"/>
                                <Button text="Review Auctions" onAction="#onTabAuctions" styleClass="button, btn-outline" style="-fx-font-size: 12px;"/>
                            </HBox>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="12" styleClass="card" style="-fx-padding: 24px;">
                            <Label text="System Status" styleClass="heading-3"/>
                            <Label text="Server: Online" styleClass="body-text" style="-fx-text-fill: -success;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ── USERS TAB ─────────────────────────── -->
                <VBox fx:id="usersTab" spacing="24" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="User Management" styleClass="heading-2" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Refresh" onAction="#onTabUsers" styleClass="button, btn-outline"/>
                    </HBox>
                    <VBox spacing="0" styleClass="card" style="-fx-padding: 0;">
                        <HBox styleClass="card-img-placeholder" style="-fx-background-radius: 0; -fx-padding: 10px 20px; -fx-border-width: 1px 0 1px 0;">
                            <Label text="Username" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Email"    prefWidth="200" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Role"     prefWidth="90"  styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Status"   prefWidth="90"  styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Actions"  prefWidth="120" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                        </HBox>
                        <VBox fx:id="usersTableContainer"/>
                    </VBox>
                </VBox>

                <!-- ── AUCTIONS TAB ──────────────────────── -->
                <VBox fx:id="auctionsTab" spacing="24" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Auction Management" styleClass="heading-2" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Refresh" onAction="#onTabAuctions" styleClass="button, btn-outline"/>
                    </HBox>
                    <VBox spacing="0" styleClass="card" style="-fx-padding: 0;">
                        <HBox styleClass="card-img-placeholder" style="-fx-background-radius: 0; -fx-padding: 10px 20px; -fx-border-width: 1px 0 1px 0;">
                            <Label text="Item title"    HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Seller"        prefWidth="130" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Current price" prefWidth="110" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Status"        prefWidth="90"  styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Actions"       prefWidth="100" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                        </HBox>
                        <VBox fx:id="auctionsTableContainer"/>
                    </VBox>
                </VBox>

                <!-- ── WALLET APPROVAL TAB ────────────────── -->
                <VBox fx:id="walletTab" spacing="24" visible="false" managed="false">
                    <Label text="Pending Fund Requests" styleClass="heading-2"/>
                    <VBox spacing="0" styleClass="card" style="-fx-padding: 0;">
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 20px;">
                            <Label text="Pending requests" styleClass="heading-3" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Refresh" onAction="#onTabWallet" styleClass="button, btn-outline" style="-fx-padding: 6px 16px;"/>
                        </HBox>
                        <HBox styleClass="card-img-placeholder" style="-fx-background-radius: 0; -fx-padding: 10px 20px; -fx-border-width: 1px 0 1px 0;">
                            <Label text="Request ID" prefWidth="120" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="User ID"    HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Amount"     prefWidth="120" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Timestamp"  prefWidth="160" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Actions"    prefWidth="180" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                        </HBox>
                        <VBox fx:id="walletTableContainer"/>
                    </VBox>
                </VBox>

                <!-- ── BIDS LOG TAB ────────────────── -->
                <VBox fx:id="bidsTab" spacing="24" visible="false" managed="false">
                    <Label text="System-wide Bids Log" styleClass="heading-2"/>
                    <VBox spacing="0" styleClass="card" style="-fx-padding: 0;">
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 20px;">
                            <Label text="All bid transactions" styleClass="heading-3" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Refresh" onAction="#onTabBids" styleClass="button, btn-outline" style="-fx-padding: 6px 16px;"/>
                        </HBox>
                        <HBox styleClass="card-img-placeholder" style="-fx-background-radius: 0; -fx-padding: 10px 20px; -fx-border-width: 1px 0 1px 0;">
                            <Label text="Bid ID"    prefWidth="160" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Item ID"   prefWidth="120" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Bidder"    HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Amount"    prefWidth="110" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                            <Label text="Timestamp" prefWidth="160" styleClass="label-bold" style="-fx-font-size: 11px;"/>
                        </HBox>
                        <VBox fx:id="bidsTableContainer"/>
                    </VBox>
                </VBox>

                <VBox fx:id="tabPlaceholder" alignment="CENTER" spacing="15" style="-fx-padding: 80px 0;" visible="false" managed="false">
                    <ProgressIndicator/>
                    <Label text="Loading content..." styleClass="body-text"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
