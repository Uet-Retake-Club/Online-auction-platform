<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<!--
    SignUpView.fxml
    Controller : com.auction.client.controllers.SignupController
    CSS        : main.css loaded in ClientApplication.java
    Size       : 900 x 620 — split left/right layout
-->
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.controllers.SignupController"
      fx:id="rootPane"
      prefWidth="900" prefHeight="620">

    <!-- ════════════════════════════════════════════════════
         LEFT PANEL  — black brand panel
         ════════════════════════════════════════════════════ -->
    <VBox prefWidth="300"
          alignment="CENTER_LEFT"
          spacing="0"
          style="-fx-background-color: #111111; -fx-padding: 52px 40px;">

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="0">
            <Label text="Auction"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;
                          -fx-text-fill: #E53238; -fx-font-family: 'Segoe UI';"/>
            <Label text="Hub"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;
                          -fx-text-fill: white; -fx-font-family: 'Segoe UI';"/>
        </HBox>

        <!-- Tagline -->
        <Label text="Join millions of buyers&#10;and sellers worldwide."
               style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.5);
                      -fx-font-family: 'Segoe UI'; -fx-padding: 8px 0 32px 0;
                      -fx-line-spacing: 4px;"/>

        <!-- Feature bullets -->
        <VBox spacing="14">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Circle radius="4" fill="#E53238"/>
                <Label text="Free to join"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.75);
                              -fx-font-family: 'Segoe UI';"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Circle radius="4" fill="#E53238"/>
                <Label text="Bid on any item instantly"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.75);
                              -fx-font-family: 'Segoe UI';"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Circle radius="4" fill="#E53238"/>
                <Label text="Sell your items easily"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.75);
                              -fx-font-family: 'Segoe UI';"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Circle radius="4" fill="#E53238"/>
                <Label text="Buyer protection guaranteed"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.75);
                              -fx-font-family: 'Segoe UI';"/>
            </HBox>

        </VBox>

    </VBox>

    <!-- ════════════════════════════════════════════════════
         RIGHT PANEL — sign-up form
         ════════════════════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS"
          alignment="CENTER"
          style="-fx-background-color: #F7F7F7; -fx-padding: 36px;">

        <!-- White card -->
        <VBox maxWidth="400"
              spacing="0"
              style="-fx-background-color: white;
                     -fx-border-color: #EBEBEB;
                     -fx-border-width: 1px;
                     -fx-border-radius: 12px;
                     -fx-background-radius: 12px;
                     -fx-padding: 32px;">

            <!-- Card heading -->
            <Label text="Create your account"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;
                          -fx-font-family: 'Segoe UI'; -fx-text-fill: #111111;"/>
            <Label text="Free, takes under a minute"
                   style="-fx-font-size: 13px; -fx-text-fill: #888888;
                          -fx-font-family: 'Segoe UI'; -fx-padding: 4px 0 22px 0;"/>

            <!-- First name + Last name row -->
            <HBox spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="0">
                    <Label text="First name"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #333333; -fx-font-family: 'Segoe UI';
                                  -fx-padding: 0 0 5px 0;"/>
                    <TextField fx:id="firstNameField"
                               promptText="John"
                               styleClass="text-field-base"
                               maxWidth="Infinity"/>
                    <Label fx:id="firstNameError" text=""
                           styleClass="field-error"
                           style="-fx-min-height: 16px; -fx-padding: 3px 0 8px 0;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="0">
                    <Label text="Last name"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #333333; -fx-font-family: 'Segoe UI';
                                  -fx-padding: 0 0 5px 0;"/>
                    <TextField fx:id="lastNameField"
                               promptText="Doe"
                               styleClass="text-field-base"
                               maxWidth="Infinity"/>
                    <Label fx:id="lastNameError" text=""
                           styleClass="field-error"
                           style="-fx-min-height: 16px; -fx-padding: 3px 0 8px 0;"/>
                </VBox>
            </HBox>

            <!-- Username -->
            <Label text="Username"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #333333; -fx-font-family: 'Segoe UI';
                          -fx-padding: 0 0 5px 0;"/>
            <TextField fx:id="usernameField"
                       promptText="Choose a username"
                       styleClass="text-field-base"
                       maxWidth="Infinity"/>
            <Label fx:id="usernameError" text=""
                   styleClass="field-error"
                   style="-fx-min-height: 16px; -fx-padding: 3px 0 8px 0;"/>

            <!-- Email -->
            <Label text="Email address"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #333333; -fx-font-family: 'Segoe UI';
                          -fx-padding: 0 0 5px 0;"/>
            <TextField fx:id="emailField"
                       promptText="you@example.com"
                       styleClass="text-field-base"
                       maxWidth="Infinity"/>
            <Label fx:id="emailError" text=""
                   styleClass="field-error"
                   style="-fx-min-height: 16px; -fx-padding: 3px 0 8px 0;"/>

            <!-- Password -->
            <Label text="Password"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #333333; -fx-font-family: 'Segoe UI';
                          -fx-padding: 0 0 5px 0;"/>
            <PasswordField fx:id="passwordField"
                           promptText="At least 8 characters"
                           styleClass="text-field-base"
                           maxWidth="Infinity"/>
            <Label fx:id="passwordError" text=""
                   styleClass="field-error"
                   style="-fx-min-height: 16px; -fx-padding: 3px 0 8px 0;"/>

            <!-- Confirm password -->
            <Label text="Confirm password"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #333333; -fx-font-family: 'Segoe UI';
                          -fx-padding: 0 0 5px 0;"/>
            <PasswordField fx:id="confirmPasswordField"
                           promptText="Repeat your password"
                           styleClass="text-field-base"
                           maxWidth="Infinity"/>
            <Label fx:id="confirmPasswordError" text=""
                   styleClass="field-error"
                   style="-fx-min-height: 16px; -fx-padding: 3px 0 6px 0;"/>

            <!-- General error -->
            <Label fx:id="generalError" text=""
                   style="-fx-text-fill: #E53238; -fx-font-size: 12px;
                          -fx-font-family: 'Segoe UI';
                          -fx-min-height: 16px; -fx-padding: 0 0 8px 0;"/>

            <!-- Create account button -->
            <Button fx:id="signUpButton"
                    text="Create account"
                    styleClass="button, btn-primary"
                    maxWidth="Infinity"
                    onAction="#onSignUp"
                    style="-fx-pref-height: 42px; -fx-font-size: 14px;"/>

            <!-- Sign in link -->
            <HBox alignment="CENTER" spacing="4"
                  style="-fx-padding: 16px 0 0 0;">
                <Label text="Already have an account?"
                       style="-fx-font-size: 13px; -fx-text-fill: #888888;
                              -fx-font-family: 'Segoe UI';"/>
                <Label fx:id="loginLabel"
                       text="Sign in"
                       style="-fx-font-size: 13px; -fx-text-fill: #1A73E8;
                              -fx-cursor: hand; -fx-font-family: 'Segoe UI';"
                       onMouseClicked="#onGoToLogin"/>
            </HBox>

        </VBox>
    </VBox>

</HBox>
